<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 电池优化白名单设置页（ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS）需要此权限。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- 屏幕监控前台服务。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14+：specialUse 类型前台服务必须声明对应权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Android 13+：常驻通知需要运行时申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 悬浮窗权限：Android 10+ 后台启动 Activity 的官方豁免项，
         是"到点自动切到休息页"的关键前提（亦为悬浮层兜底所需）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Android 14+ 全屏 intent 需用户手动授权；未授权时退化为高优横幅通知。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Device Admin：允许 DeviceAdminReceiver 注册，用于 lockNow() 自动熄屏。 -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN"/>
    <!-- 第 4 步开机自启使用，先声明。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 划掉应用后经精确闹钟自动重启前台服务（onTaskRemoved 兜底）。
         只声明 SCHEDULE_EXACT_ALARM：USE_EXACT_ALARM 面向日历/闹钟类应用，
         本应用场景不符，审核可能被拒。Android 12-13 安装即授予；
         Android 14+ 默认不授予，走"检查权限 → 权限引导页引导开启 →
         降级非精确闹钟兜底"的路径（见 ScreenMonitorService.scheduleRestart）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <application
        android:label="screen_time_manager"
        android:name=".ScreenMonitorApp"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 屏幕监控前台服务：Android 14+ 归为 specialUse，
             必须提供子类型说明（上架时需在 Play Console 解释用途）。
             stopWithTask=false：用户从最近任务划掉应用时不随任务停止
             （原生行为下服务存活；国产 ROM 强杀进程则由
             ServiceRestartReceiver 的重启闹钟兜底）。 -->
        <service
            android:name=".ScreenMonitorService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous screen on/off monitoring for self-managed screen time limits" />
        </service>
        <!-- 划掉应用后的自动重启：接收 ScreenMonitorService 在
             onTaskRemoved 中注册的精确闹钟（进程被杀后由系统拉起新进程
             投递，故必须静态注册）。exported=false 仅应用自身可触发。 -->
        <receiver
            android:name=".ServiceRestartReceiver"
            android:exported="false" />
        <!-- Device Admin 接收器：仅 force-lock 策略，用于休息期自动熄屏。 -->
        <receiver
            android:name=".ScreenMonitorDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- 紧急退出按键监听：电源键只能由带按键过滤能力的无障碍服务观测。
             用户需在 系统设置 → 无障碍 中手动开启。 -->
        <service
            android:name=".EmergencyKeyAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_emergency_keys" />
        </service>
        <!-- 第 4 步开机自启：仅当用户手动打开过应用后才启动监控
             （标记由 MainActivity.onCreate 写入，见 BootReceiver）。
             exported=false：BOOT_COMPLETED 是受保护系统广播，系统仍可送达。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
