<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Family Controls（屏幕使用时间）：开发调试可直接在 Xcode 勾选；
	     对外分发（TestFlight/App Store）需向 Apple 申请批准。 -->
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!-- 主 App 与 DeviceActivityMonitor 扩展共享选择项/配置的 App Group。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.keekey.screentempo</string>
	</array>
</dict>
</plist>
